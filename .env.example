# ---- Fax (Sinch Fax API v3) ----
FAX_PROVIDER=sinch
SINCH_PROJECT_ID=
SINCH_API_KEY=
SINCH_API_SECRET=
SINCH_FAX_NUMBER=+1XXXXXXXXXX      # your Sinch fax number (E.164)
SINCH_FAX_BASE=https://fax.api.sinch.com
# (Medsender kept as alternate: FAX_PROVIDER=medsender + MEDSENDER_API_KEY/MEDSENDER_FAX_NUMBER)

# ---- Storage (Azure Blob — BAA-covered) ----
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=completed-forms

# ---- Chart (Knack) ----
KNACK_APP_ID=
KNACK_REST_API_KEY=

# ---- Email (Google Workspace service account, domain-wide delegation) ----
GMAIL_SA_CLIENT_EMAIL=
GMAIL_SA_PRIVATE_KEY=          # paste with \n escapes, or use a secret manager
GMAIL_SEND_AS=noreply@psychiatrygroup.com
EMAIL_EXTERNAL_MODE=secure_link   # secure_link | attachment
